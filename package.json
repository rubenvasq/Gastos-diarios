{
  "name": "gastosdiarios",
  "version": "1.0.0",
  "description": "Control de gastos personales — sabe en qué se va tu dinero",
  "type": "module",
  "scripts": {
    "start": "npx --yes serve . -p 3000",
    "preview": "npm start",
    "test": "node smoke.mjs && node tests/agent-tools.smoke.mjs",
    "build": "node scripts/build-www.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android"
  },
  "keywords": [
    "finanzas",
    "gastos",
    "presupuesto",
    "personal-finance"
  ],
  "license": "MIT",
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
